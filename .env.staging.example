# Copy to an environment-specific secret store or local .env only for staging validation.
# Do not commit real secrets. Values marked change-me-in-production must be replaced.

POSTGRES_DB=realmeet_staging
POSTGRES_USER=realmeet_staging
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=25432
BACKEND_PORT=18000
FRONTEND_PORT=15173

APP_NAME=RealMeet API
APP_ENV=staging
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=["https://staging.realmeet.example"]
STAGING_ALLOW_LOCALHOST=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@staging.realmeet.example
SMTP_FROM_NAME=RealMeet Staging
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_MODE=log

DEFAULT_MEETING_PROVIDER=mock
MOCK_MEETING_BASE_URL=https://staging.realmeet.example/mock-meeting
ENABLE_DOCS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10
ENABLE_DEMO_SEED=false
BACKEND_HOST=0.0.0.0
BACKEND_INTERNAL_PORT=8000
VITE_API_URL=https://api.staging.realmeet.example

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Staging callback when OAuth is enabled:
# https://api.staging.realmeet.example/api/v1/admin/integrations/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.events
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_TOKEN_ENCRYPTION_KEY=

WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DEFAULT_LANGUAGE=es_CL
WHATSAPP_DEFAULT_COUNTRY_CODE=CL
WHATSAPP_PHONE_HMAC_KEY=
WHATSAPP_WEBHOOK_PUBLIC_URL=https://api.staging.realmeet.example/api/v1/integrations/whatsapp/webhook
WHATSAPP_WEBHOOK_MAX_BODY_BYTES=262144
WHATSAPP_WEBHOOK_EVENT_RETENTION_DAYS=30
WHATSAPP_WEBHOOK_REQUIRE_SIGNATURE=true
WHATSAPP_HTTP_CONNECT_TIMEOUT_SECONDS=3
WHATSAPP_HTTP_READ_TIMEOUT_SECONDS=8
WHATSAPP_HTTP_TOTAL_TIMEOUT_SECONDS=10
