POSTGRES_DB=realmeet
POSTGRES_USER=realmeet
POSTGRES_PASSWORD=realmeet
POSTGRES_PORT=25432
BACKEND_PORT=18000
FRONTEND_PORT=15173
APP_NAME=RealMeet API
APP_ENV=docker
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=["http://localhost:15173","http://127.0.0.1:15173"]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@realmeet.local
SMTP_FROM_NAME=RealMeet
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_MODE=log
DEFAULT_MEETING_PROVIDER=mock
MOCK_MEETING_BASE_URL=http://localhost:15173/mock-meeting
ENABLE_DOCS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10
ENABLE_DEMO_SEED=true
BACKEND_HOST=0.0.0.0
BACKEND_INTERNAL_PORT=8000
VITE_API_URL=http://localhost:18000

# Google OAuth foundation for future Google Meet support.
# Leave secrets empty in Git. Do not store tokens or real client secrets here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:18000/api/v1/admin/integrations/oauth/google/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.events
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_TOKEN_ENCRYPTION_KEY=

# WhatsApp Cloud foundation (13.1A). Leave secrets empty in Git.
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DEFAULT_LANGUAGE=es_CL
WHATSAPP_DEFAULT_COUNTRY_CODE=CL
WHATSAPP_PHONE_HMAC_KEY=
WHATSAPP_WEBHOOK_PUBLIC_URL=
WHATSAPP_WEBHOOK_MAX_BODY_BYTES=262144
WHATSAPP_WEBHOOK_EVENT_RETENTION_DAYS=30
WHATSAPP_WEBHOOK_REQUIRE_SIGNATURE=true
WHATSAPP_HTTP_CONNECT_TIMEOUT_SECONDS=3
WHATSAPP_HTTP_READ_TIMEOUT_SECONDS=8
WHATSAPP_HTTP_TOTAL_TIMEOUT_SECONDS=10
