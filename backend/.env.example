APP_NAME=RealMeet API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=postgresql+pg8000://realmeet:realmeet@localhost:25432/realmeet
CORS_ORIGINS=["http://localhost:15173","http://127.0.0.1:15173"]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@realmeet.local
SMTP_FROM_NAME=RealMeet
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_MODE=log
DEFAULT_MEETING_PROVIDER=mock
MOCK_MEETING_BASE_URL=http://localhost:15173/mock-meeting
ENABLE_DOCS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10
ENABLE_DEMO_SEED=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
